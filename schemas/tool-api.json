{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mediaforge.dev/schemas/tool-api.json",
  "title": "MediaForge Tool API",
  "type": "object",
  "required": ["operation"],
  "properties": {
    "operation": {
      "type": "string",
      "enum": [
        "inspect", "inspect_media",
        "plan", "plan_media_operation",
        "convert", "convert_media",
        "compress", "compress_media",
        "resize", "resize_media",
        "clip", "clip_media",
        "extract_audio", "extract-audio",
        "thumbnail", "create_thumbnail", "create-thumbnail",
        "batch",
        "verify", "verify_media",
        "capabilities",
        "ffmpeg"
      ]
    },
    "target_operation": {
      "type": "string",
      "enum": ["convert", "compress", "resize", "clip", "extract_audio", "extract-audio", "thumbnail", "create_thumbnail", "create-thumbnail"],
      "description": "Semantic operation to plan when operation is plan; omitted values are inferred from the supplied fields."
    },
    "input": { "type": "string", "minLength": 1 },
    "output": { "type": "string" },
    "output_format": { "type": "string", "enum": ["mp4", "mkv", "mov", "webm"] },
    "video_codec": { "type": "string", "enum": ["auto", "copy", "h264", "h265", "vp9", "av1"] },
    "audio_codec": { "type": "string", "enum": ["auto", "copy", "aac", "opus", "mp3"] },
    "quality": { "type": "string", "enum": ["lossless", "very-high", "very_high", "high", "balanced", "small", "tiny"] },
    "hardware": { "type": "string", "enum": ["auto", "cpu", "gpu"] },
    "target_size": { "type": "string", "description": "Approximate target size such as 500MB or 1.5GB." },
    "width": { "type": "integer", "minimum": 1 },
    "resolution": { "type": "string", "description": "Target height such as 1080p." },
    "start": { "type": "string" },
    "duration": { "type": "string" },
    "end": { "type": "string" },
    "format": { "type": "string", "enum": ["mp3", "aac", "m4a", "flac", "wav", "opus"] },
    "at": { "type": "string", "description": "Thumbnail position in seconds, HH:MM:SS, or a percentage." },
    "recursive": { "type": "boolean", "default": false },
    "output_dir": { "type": "string" },
    "args": {
      "type": "array",
      "description": "Raw FFmpeg arguments. Use only for operations not covered by MediaForge semantics.",
      "items": { "type": "string" }
    },
    "overwrite": { "type": "boolean", "default": false },
    "dry_run": { "type": "boolean", "default": false },
    "verify_after_execute": { "type": "boolean", "default": true },
    "progress": {
      "type": "boolean",
      "default": false,
      "description": "Emit FFmpeg progress events as NDJSON on stderr while keeping stdout machine-readable."
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "enum": [
              "inspect", "inspect_media", "plan", "plan_media_operation",
              "convert", "convert_media", "compress", "compress_media",
              "resize", "resize_media", "clip", "clip_media", "extract_audio", "extract-audio",
              "thumbnail", "create_thumbnail", "create-thumbnail", "batch", "verify", "verify_media"
            ]
          }
        }
      },
      "then": { "required": ["input"] }
    },
    {
      "if": {
        "properties": {
          "operation": { "enum": ["verify", "verify_media"] }
        }
      },
      "then": { "required": ["input", "output"] }
    },
    {
      "if": {
        "properties": { "operation": { "const": "ffmpeg" } }
      },
      "then": { "required": ["args"] }
    }
  ],
  "additionalProperties": true
}
